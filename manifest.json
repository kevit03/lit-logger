{
  "manifest_version": 3,
  "name": "LIT: Job & LeetCode Tracker",
  "version": "1.5.0",
  "description": "Track job applications, LeetCodes, and streaks on Google Calendar. Auto-logs LeetCode, NeetCode, and applications, and autofills application forms on Greenhouse, Lever, Ashby, Workday, and other career sites.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LIT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/autofill.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "content/adapters/leetcode.js",
        "content/auto-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://neetcode.io/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "content/adapters/neetcode.js",
        "content/auto-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "content/adapters/ats/confirmation.js",
        "content/adapters/ats/greenhouse.js",
        "content/adapters/ats/lever.js",
        "content/adapters/ats/ashby.js",
        "content/adapters/ats/workday.js",
        "content/auto-tracker.js",
        "shared/autofill-store.js",
        "shared/autofill-core.js",
        "content/autofill/sites/greenhouse.js",
        "content/autofill/sites/lever.js",
        "content/autofill/sites/ashby.js",
        "content/autofill/sites/workday.js",
        "content/autofill/autofill-ui.js"
      ],
      "css": [
        "content/autofill/autofill-ui.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.workable.com/*",
        "*://*.bamboohr.com/*",
        "*://*.rippling-ats.com/*",
        "https://ats.rippling.com/*",
        "*://*.icims.com/*",
        "*://*.taleo.net/*",
        "*://*.smartrecruiters.com/*",
        "*://*.jobvite.com/*",
        "*://*.applytojob.com/*",
        "*://*.breezy.hr/*",
        "*://*.recruitee.com/*",
        "*://*.pinpointhq.com/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "shared/job-meta.js",
        "content/adapters/ats/universal.js",
        "content/auto-tracker.js",
        "shared/autofill-store.js",
        "shared/autofill-core.js",
        "content/autofill/sites/greenhouse.js",
        "content/autofill/sites/lever.js",
        "content/autofill/sites/ashby.js",
        "content/autofill/sites/workday.js",
        "content/autofill/autofill-ui.js"
      ],
      "css": [
        "content/autofill/autofill-ui.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "alarms",
    "notifications",
    "contextMenus",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "commands": {
    "increment-active": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Log +1 to the tracker selected in LIT"
    },
    "open-search": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Open LIT with search focused"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
