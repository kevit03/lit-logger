{
  "manifest_version": 3,
  "name": "LIT: Job & LeetCode Tracker",
  "version": "1.3.0",
  "description": "Track job applications, LeetCodes, and daily streaks with a direct visual overlay on Google Calendar. Auto-logs LeetCode and NeetCode solves and ATS job applications.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LIT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://calendar.google.com/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://leetcode.cn/problems/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "content/adapters/leetcode.js",
        "content/auto-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://neetcode.io/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "content/adapters/neetcode.js",
        "content/auto-tracker.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "shared/auth.js",
        "shared/storage.js",
        "shared/auto-tracker-core.js",
        "content/adapters/ats/confirmation.js",
        "content/adapters/ats/greenhouse.js",
        "content/adapters/ats/lever.js",
        "content/adapters/ats/ashby.js",
        "content/adapters/ats/workday.js",
        "content/auto-tracker.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "identity",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
